{
  "name": "accuratrail-validation-framework",
  "version": "1.0.0",
  "description": "21 CFR Part 11 programmatic validation package generator for AccuraTrial EDC",
  "private": true,
  "scripts": {
    "generate": "ts-node generate.ts",
    "generate:docs": "ts-node generate.ts --docs-only",
    "generate:iq": "ts-node generate.ts --iq",
    "generate:oq": "ts-node generate.ts --oq",
    "generate:pq": "ts-node generate.ts --pq",
    "generate:all": "ts-node generate.ts --all"
  },
  "dependencies": {
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  }
}
